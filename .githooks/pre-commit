#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

default_branch=$(./scripts/default-branch.sh)
current_branch=$(git branch --show-current)
if [ "$current_branch" = "$default_branch" ]; then
  printf '%s\n' "Refusing to commit directly to $default_branch." >&2
  printf '%s\n' "Create a feature branch first: git switch -c <branch>" >&2
  exit 1
fi

./scripts/check.sh
